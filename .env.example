# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# CODEIGNITER 4 ON VERCEL SERVERLESS CONFIGURATION
# ==============================================================================
CI_ENVIRONMENT=production
app.baseURL="https://my-shoe-store.vercel.app/"
app.sessionSavePath="/tmp"

# Cloud Database Connection (e.g., PlanetScale, Supabase, Neon, AWS RDS, Aiven)
DB_HOST=aws.connect.psdb.cloud
DB_PORT=3306
DB_NAME=shoestore_db
DB_USER=shoe_admin
DB_PASS=your_secure_db_password_here
DB_DRIVER=MySQLi

# WhatsApp Order API Configuration
# Clicking 'Checkout Now' sends full shoe details & price to this WhatsApp number
WHATSAPP_PHONE_NUMBER="0780803908"
WHATSAPP_COUNTRY_CODE="254" # Kenya (+254) -> 254780803908
WHATSAPP_API_ENDPOINT="https://api.whatsapp.com/send"

# Cloudinary Storage Configuration (Recommended for ephemeral Vercel environments)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=shoe_store_preset

# Alternative: AWS S3 Storage
AWS_ACCESS_KEY_ID=your_aws_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=my-shoe-ecommerce-assets

# Initial Admin Credentials (for seed migration)
ADMIN_EMAIL=admin@solestore.com
ADMIN_PASSWORD=AdminSecurePass2025!

