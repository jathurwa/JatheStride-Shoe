{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1",
      "maxDuration": 15,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "^/(assets|css|js|images|static|favicon.ico)(.*)$",
      "dest": "/public/$1$2"
    },
    {
      "src": "^(.*)$",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "CI_ENVIRONMENT": "production"
  }
}
